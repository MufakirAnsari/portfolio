{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|pdf|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/reviews", "dest": "/reviews.html" },
    { "src": "/certifications", "dest": "/certifications.html" },
    { "src": "/code", "dest": "/certifications.html" },
    { "src": "/hire-me", "dest": "/hire_me.html" },
    { "src": "/hire_me", "dest": "/hire_me.html" },
    { "src": "/freelance", "dest": "/freelance.html" },
    { "src": "/consulting", "dest": "/freelance.html" },
    { "src": "/bio", "dest": "/bio.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/home", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
